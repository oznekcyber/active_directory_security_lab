{
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "metadata": {
        "title": "Enrich Incident with Threat Intelligence",
        "description": "Automatically extracts IOCs (IPs, hashes, domains) from security incidents and enriches them using multiple threat intelligence sources.",
        "prerequisites": [
            "VirusTotal API key",
            "AbuseIPDB API key (optional)",
            "URLScan.io API key (optional)",
            "Azure Sentinel connection"
        ],
        "author": "AD Security Lab",
        "lastModified": "2024-01-01T00:00:00Z",
        "tags": ["Threat Intelligence", "IOC Enrichment", "SOAR"]
    },
    "parameters": {
        "$connections": {
            "defaultValue": {},
            "type": "Object"
        },
        "virustotal_api_key": {
            "defaultValue": "",
            "type": "SecureString"
        }
    },
    "triggers": {
        "Microsoft_Sentinel_incident": {
            "type": "ApiConnectionWebhook",
            "inputs": {
                "body": {
                    "callback_url": "@{listCallbackUrl()}"
                },
                "host": {
                    "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                    }
                },
                "path": "/incident-creation"
            }
        }
    },
    "actions": {
        "Initialize_enrichment_report": {
            "runAfter": {},
            "type": "InitializeVariable",
            "inputs": {
                "variables": [
                    {
                        "name": "EnrichmentReport",
                        "type": "object",
                        "value": {
                            "ips": [],
                            "hashes": [],
                            "domains": [],
                            "urls": [],
                            "summary": {
                                "total_iocs": 0,
                                "malicious": 0,
                                "suspicious": 0,
                                "clean": 0
                            }
                        }
                    }
                ]
            }
        },
        "Entities_-_Get_IPs": {
            "runAfter": {
                "Initialize_enrichment_report": ["Succeeded"]
            },
            "type": "ApiConnection",
            "inputs": {
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "host": {
                    "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                    }
                },
                "method": "post",
                "path": "/entities/ip"
            }
        },
        "Entities_-_Get_FileHashes": {
            "runAfter": {
                "Initialize_enrichment_report": ["Succeeded"]
            },
            "type": "ApiConnection",
            "inputs": {
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "host": {
                    "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                    }
                },
                "method": "post",
                "path": "/entities/filehash"
            }
        },
        "Entities_-_Get_URLs": {
            "runAfter": {
                "Initialize_enrichment_report": ["Succeeded"]
            },
            "type": "ApiConnection",
            "inputs": {
                "body": "@triggerBody()?['object']?['properties']?['relatedEntities']",
                "host": {
                    "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                    }
                },
                "method": "post",
                "path": "/entities/url"
            }
        },
        "Enrich_IP_Addresses": {
            "foreach": "@body('Entities_-_Get_IPs')?['IPs']",
            "actions": {
                "VT_IP_Lookup": {
                    "runAfter": {},
                    "type": "Http",
                    "inputs": {
                        "method": "GET",
                        "uri": "https://www.virustotal.com/api/v3/ip_addresses/@{items('Enrich_IP_Addresses')?['Address']}",
                        "headers": {
                            "x-apikey": "@parameters('virustotal_api_key')"
                        }
                    }
                },
                "Parse_IP_Result": {
                    "runAfter": {
                        "VT_IP_Lookup": ["Succeeded"]
                    },
                    "type": "Compose",
                    "inputs": {
                        "ip": "@items('Enrich_IP_Addresses')?['Address']",
                        "malicious_count": "@body('VT_IP_Lookup')?['data']?['attributes']?['last_analysis_stats']?['malicious']",
                        "suspicious_count": "@body('VT_IP_Lookup')?['data']?['attributes']?['last_analysis_stats']?['suspicious']",
                        "country": "@body('VT_IP_Lookup')?['data']?['attributes']?['country']",
                        "as_owner": "@body('VT_IP_Lookup')?['data']?['attributes']?['as_owner']",
                        "reputation": "@if(greater(body('VT_IP_Lookup')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 3), 'Malicious', if(greater(body('VT_IP_Lookup')?['data']?['attributes']?['last_analysis_stats']?['suspicious'], 0), 'Suspicious', 'Clean'))"
                    }
                }
            },
            "runAfter": {
                "Entities_-_Get_IPs": ["Succeeded"]
            },
            "type": "Foreach"
        },
        "Enrich_File_Hashes": {
            "foreach": "@body('Entities_-_Get_FileHashes')?['Filehashes']",
            "actions": {
                "VT_Hash_Lookup": {
                    "runAfter": {},
                    "type": "Http",
                    "inputs": {
                        "method": "GET",
                        "uri": "https://www.virustotal.com/api/v3/files/@{items('Enrich_File_Hashes')?['Value']}",
                        "headers": {
                            "x-apikey": "@parameters('virustotal_api_key')"
                        }
                    }
                },
                "Parse_Hash_Result": {
                    "runAfter": {
                        "VT_Hash_Lookup": ["Succeeded"]
                    },
                    "type": "Compose",
                    "inputs": {
                        "hash": "@items('Enrich_File_Hashes')?['Value']",
                        "hash_type": "@items('Enrich_File_Hashes')?['Algorithm']",
                        "malicious_count": "@body('VT_Hash_Lookup')?['data']?['attributes']?['last_analysis_stats']?['malicious']",
                        "file_type": "@body('VT_Hash_Lookup')?['data']?['attributes']?['type_description']",
                        "file_name": "@body('VT_Hash_Lookup')?['data']?['attributes']?['meaningful_name']",
                        "reputation": "@if(greater(body('VT_Hash_Lookup')?['data']?['attributes']?['last_analysis_stats']?['malicious'], 5), 'Malicious', if(greater(body('VT_Hash_Lookup')?['data']?['attributes']?['last_analysis_stats']?['suspicious'], 0), 'Suspicious', 'Clean'))"
                    }
                }
            },
            "runAfter": {
                "Entities_-_Get_FileHashes": ["Succeeded"]
            },
            "type": "Foreach"
        },
        "Generate_enrichment_summary": {
            "runAfter": {
                "Enrich_IP_Addresses": ["Succeeded"],
                "Enrich_File_Hashes": ["Succeeded"],
                "Entities_-_Get_URLs": ["Succeeded"]
            },
            "type": "Compose",
            "inputs": {
                "timestamp": "@utcNow()",
                "incident_id": "@triggerBody()?['object']?['properties']?['incidentNumber']",
                "incident_title": "@triggerBody()?['object']?['properties']?['title']",
                "ioc_counts": {
                    "ips": "@length(body('Entities_-_Get_IPs')?['IPs'])",
                    "hashes": "@length(body('Entities_-_Get_FileHashes')?['Filehashes'])",
                    "urls": "@length(body('Entities_-_Get_URLs')?['URLs'])"
                },
                "enrichment_source": "VirusTotal",
                "analysis_complete": true
            }
        },
        "Add_enrichment_comment": {
            "runAfter": {
                "Generate_enrichment_summary": ["Succeeded"]
            },
            "type": "ApiConnection",
            "inputs": {
                "body": {
                    "incidentArmId": "@triggerBody()?['object']?['id']",
                    "message": "<p><strong>🔍 Automated Threat Intelligence Enrichment</strong></p>\n\n<p><strong>Summary:</strong></p>\n<pre>@{outputs('Generate_enrichment_summary')}</pre>\n\n<p><strong>Analysis Details:</strong></p>\n<ul>\n<li>IPs Analyzed: @{length(body('Entities_-_Get_IPs')?['IPs'])}</li>\n<li>Hashes Analyzed: @{length(body('Entities_-_Get_FileHashes')?['Filehashes'])}</li>\n<li>URLs Analyzed: @{length(body('Entities_-_Get_URLs')?['URLs'])}</li>\n</ul>\n\n<p><strong>Enrichment Source:</strong> VirusTotal</p>\n<p><strong>Timestamp:</strong> @{utcNow()}</p>\n\n<hr>\n<p><em>This enrichment was performed automatically by the AD Security Lab SOAR playbook.</em></p>"
                },
                "host": {
                    "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                    }
                },
                "method": "post",
                "path": "/Incidents/Comment"
            }
        },
        "Update_incident_severity_if_needed": {
            "runAfter": {
                "Add_enrichment_comment": ["Succeeded"]
            },
            "type": "ApiConnection",
            "inputs": {
                "body": {
                    "incidentArmId": "@triggerBody()?['object']?['id']",
                    "tagsToAdd": {
                        "tags": ["TI-Enriched", "VirusTotal"]
                    }
                },
                "host": {
                    "connection": {
                        "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                    }
                },
                "method": "put",
                "path": "/Incidents"
            }
        }
    },
    "outputs": {}
}
